```csharp
// --- DTOs for Battle Logs ---

/// <summary>
/// Represents a single battle log entry.
/// </summary>
public class BattleLogDto
{
    [JsonProperty("id")]
    public string Id { get; set; }

    [JsonProperty("monsterName")]
    public string MonsterName { get; set; }

    [JsonProperty("monsterLevel")]
    public int MonsterLevel { get; set; }

    [JsonProperty("isVictory")]
    public bool IsVictory { get; set; }

    [JsonProperty("experienceGained")]
    public int ExperienceGained { get; set; }

    [JsonProperty("goldGained")]
    public int GoldGained { get; set; }

    [JsonProperty("damageDealt")]
    public int DamageDealt { get; set; }

    [JsonProperty("damageTaken")]
    public int DamageTaken { get; set; }

    [JsonProperty("battleDate")]
    public string BattleDate { get; set; }
}

/// <summary>
/// Represents a paginated response for battle logs.
/// </summary>
public class BattleLogsResponse
{
    [JsonProperty("logs")]
    public List<BattleLogDto> Logs { get; set; }

    [JsonProperty("currentPage")]
    public int CurrentPage { get; set; }

    [JsonProperty("pageSize")]
    public int PageSize { get; set; }

    [JsonProperty("totalCount")]
    public int TotalCount { get; set; }

    [JsonProperty("totalPages")]
    public int TotalPages { get; set; }
}


// --- Additional Wrapper Classes for Battle API Responses ---

/// <summary>
/// Wrapper for the GET /api/battle/logs endpoint response.
/// </summary>
public class BattleLogsResponseWrapper
{
    [JsonProperty("response")]
    public BattleLogsResponse Response { get; set; }
}

/// <summary>
/// Wrapper for the GET /api/battle/logs/recent endpoint response.
/// </summary>
public class RecentBattleLogsResponseWrapper
{
    [JsonProperty("response")]
    public List<BattleLogDto> Response { get; set; }
}

/// <summary>
/// Wrapper for the GET /api/battle/stats endpoint response.
/// Assumes BattleStatsData is the existing client-side DTO for battle statistics.
/// </summary>
public class BattleStatsResponseWrapper
{
    [JsonProperty("response")]
    public BattleStatsData Response { get; set; }
}
```
