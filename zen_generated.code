using System;
using System.Collections.Generic;
using Newtonsoft.Json;
using Newtonsoft.Json.Converters;

/// <summary>
/// Defines the slot where a piece of equipment can be worn.
/// </summary>
[JsonConverter(typeof(StringEnumConverter))]
public enum EquipmentSlot
{
    Weapon = 1,
    Helmet = 2,
    Armor = 3,
    Gloves = 4,
    Boots = 5
}

/// <summary>
/// Defines the rarity levels for equipment.
/// </summary>
[JsonConverter(typeof(StringEnumConverter))]
public enum EquipmentRarity
{
    Common = 1,
    Uncommon = 2,
    Rare = 3,
    Epic = 4,
    Legendary = 5
}

/// <summary>
/// Represents detailed information about a piece of equipment.
/// This DTO matches the complete server-side definition.
/// </summary>
public class EquipmentDTO
{
    [JsonProperty("id")]
    public string Id { get; set; }

    [JsonProperty("name")]
    public string Name { get; set; }

    [JsonProperty("slot")]
    public EquipmentSlot Slot { get; set; }

    [JsonProperty("rarity")]
    public EquipmentRarity Rarity { get; set; }

    [JsonProperty("ownerId")]
    public string OwnerId { get; set; }

    [JsonProperty("characterId")]
    public string CharacterId { get; set; } // Nullable Guid becomes a string that can be null

    [JsonProperty("enhancementLevel")]
    public int EnhancementLevel { get; set; }

    [JsonProperty("baseAttack")]
    public int BaseAttack { get; set; }

    [JsonProperty("baseDefense")]
    public int BaseDefense { get; set; }

    [JsonProperty("baseHp")]
    public int BaseHp { get; set; }

    [JsonProperty("totalAttack")]
    public int TotalAttack { get; set; }

    [JsonProperty("totalDefense")]
    public int TotalDefense { get; set; }

    [JsonProperty("totalHp")]
    public int TotalHp { get; set; }

    [JsonProperty("createdAt")]
    public string CreatedAt { get; set; }

    [JsonProperty("updatedAt")]
    public string UpdatedAt { get; set; }
}

// Note: The wrapper classes 'EquipmentResponse' and 'EquipmentListResponse'
// should remain in this file if they are used for deserializing API responses
// like { "equipment": { ... } } or { "equipments": [ ... ] }.
// Example:
/*
public class EquipmentResponse
{
    [JsonProperty("equipment")]
    public EquipmentDTO Equipment { get; set; }
}

public class EquipmentListResponse
{
    [JsonProperty("equipments")]
    public List<EquipmentDTO> Equipments { get; set; }
}
*/
```
