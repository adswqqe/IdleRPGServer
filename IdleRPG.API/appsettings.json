{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=idlerpgdb;Username=postgres;Password=YOUR_DB_PASSWORD_HERE",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "SecretKey": "YOUR_JWT_SECRET_KEY_HERE_MIN_32_CHARACTERS_REQUIRED",
    "Issuer": "IdleRPGServer",
    "Audience": "IdleRPGClient",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  }
}